
@model IEnumerable<SistemInformasiRestoran.Models.Menu>

@{
    ViewData["Title"] = "Data Menu";

    var daftarMenu = Model?.ToList() ?? new List<SistemInformasiRestoran.Models.Menu>();

    var daftarKategori = ViewBag.DaftarKategori
        as List<SistemInformasiRestoran.Models.Kategori>
        ?? new List<SistemInformasiRestoran.Models.Kategori>();

    var budayaRupiah = System.Globalization.CultureInfo.GetCultureInfo("id-ID");
}

<style>
    .menu-page {
        padding: 8px 4px 30px;
    }

    .menu-heading h2 {
        color: #263d30;
        font-weight: 750;
        font-size: 30px;
    }

    .menu-toolbar {
        background: #fff;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 24px;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .menu-search {
        min-width: 220px;
        border-radius: 10px;
        padding: 11px 14px;
    }

    .menu-filter {
        min-width: 180px;
        border-radius: 10px;
        padding: 11px 14px;
    }

    .menu-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
    }

    .menu-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #edf0ed;
        box-shadow: 0 3px 12px rgba(0,0,0,.055);
        transition: .2s ease;
        min-width: 0;
    }

    .menu-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 22px rgba(0,0,0,.10);
    }

    /* Menu nonaktif atau stok habis */
    .menu-card.menu-nonaktif {
        background: #e9e9e9;
        border: 1px solid #d0d0d0;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .menu-card.menu-nonaktif:hover {
        transform: none;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .menu-card.menu-nonaktif .menu-image {
        filter: grayscale(100%);
        opacity: .45;
    }

    .menu-card.menu-nonaktif .menu-image-wrapper {
        background: #ddd;
    }

    .menu-card.menu-nonaktif .menu-card-body {
        background: #e9e9e9;
    }

    .menu-card.menu-nonaktif .menu-category {
        color: #777;
        background: #dcdcdc;
    }

    .menu-card.menu-nonaktif .menu-name,
    .menu-card.menu-nonaktif .menu-price,
    .menu-card.menu-nonaktif .menu-stock {
        color: #888;
    }

    .menu-card.menu-nonaktif .menu-actions {
        border-top-color: #ccc;
    }

    .menu-image-wrapper {
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #f1f4f0;
        position: relative;
        overflow: hidden;
    }

    .menu-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: .2s ease;
    }

    .menu-no-image {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #9aa69c;
        font-size: 58px;
    }

    .menu-status {
        position: absolute;
        top: 12px;
        left: 12px;
        border-radius: 20px;
        padding: 6px 11px;
        font-size: 11px;
        font-weight: 700;
        background: #e4f5e9;
        color: #187345;
    }

    .menu-status.unavailable {
        background: #d5d5d5;
        color: #555;
    }

    .menu-card-body {
        padding: 16px;
    }

    .menu-category {
        display: inline-block;
        font-size: 11px;
        font-weight: 650;
        color: #28784e;
        background: #eaf4ed;
        padding: 5px 10px;
        border-radius: 20px;
        margin-bottom: 9px;
    }

    .menu-name {
        color: #263d30;
        font-size: 17px;
        font-weight: 750;
        margin-bottom: 9px;
        min-height: 42px;
        overflow-wrap: anywhere;
    }

    .menu-price {
        color: #21834f;
        font-size: 19px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .menu-stock {
        color: #777;
        font-size: 13px;
        margin-bottom: 13px;
    }

    .menu-stock .stock-habis {
        color: #b02a37;
        font-weight: 700;
    }

    .menu-actions {
        display: flex;
        gap: 8px;
        border-top: 1px solid #eee;
        padding-top: 12px;
    }

    .menu-actions form {
        margin: 0;
        flex: 1;
    }

    .menu-actions .btn {
        width: 100%;
    }

    .menu-actions > a {
        flex: 1;
    }

    .menu-empty {
        background: #fff;
        border-radius: 18px;
        padding: 65px 20px;
        text-align: center;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
    }

    .menu-empty i {
        font-size: 55px;
        color: #9ba99e;
    }

    .menu-empty h5 {
        margin-top: 15px;
        font-weight: 700;
        color: #263d30;
    }

    .menu-empty p {
        color: #777;
    }

    .menu-no-result {
        display: none;
        text-align: center;
        padding: 45px 15px;
        color: #777;
        background: #fff;
        border-radius: 15px;
    }

    @@media (max-width: 1200px) {
        .menu-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .menu-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 13px;
        }

        .menu-card-body {
            padding: 12px;
        }

        .menu-name {
            font-size: 15px;
        }

        .menu-price {
            font-size: 16px;
        }

        .menu-toolbar {
            padding: 13px;
        }
    }

    @@media (max-width: 420px) {
        .menu-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid menu-page">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="menu-heading">
            <h2>Data Menu</h2>
            <p class="text-muted mb-0">
                Pilih dan kelola daftar makanan dan minuman restoran.
            </p>
        </div>

        @if (User.IsInRole("Manager"))
        {
            <a asp-controller="Menu"
               asp-action="Create"
               class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle me-1"></i>
                Tambah Menu
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (daftarMenu.Any())
    {
        <div class="menu-toolbar">
            <div class="row g-3">
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="cariMenu"
                               class="form-control menu-search"
                               placeholder="Cari nama makanan atau minuman..." />
                    </div>
                </div>

                <div class="col-md-5">
                    <select id="filterKategori"
                            class="form-select menu-filter">
                        <option value="">Semua Kategori</option>

                        @foreach (var kategori in daftarKategori)
                        {
                            <option value="@kategori.NamaKategori">
                                @kategori.NamaKategori
                            </option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="menu-grid" id="daftarKartuMenu">

            @foreach (var item in daftarMenu)
            {
                <div class="menu-card @((!item.StatusTersedia || item.Stok <= 0) ? "menu-nonaktif" : "")"
                     data-menu-card
                     data-nama="@item.NamaMenu"
                     data-kategori="@(item.Kategori?.NamaKategori ?? "-")">

                    <div class="menu-image-wrapper">

                        @if (!string.IsNullOrWhiteSpace(item.Gambar))
                        {
                            <img src="@Url.Content("~/uploads/menu/" + item.Gambar)"
                                 alt="Foto @item.NamaMenu"
                                 class="menu-image"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="menu-no-image">
                                <i class="bi bi-image"></i>
                            </div>
                        }

                        @if (!item.StatusTersedia)
                        {
                            <span class="menu-status unavailable">
                                Tidak Tersedia
                            </span>
                        }
                        else if (item.Stok <= 0)
                        {
                            <span class="menu-status unavailable">
                                Stok Habis
                            </span>
                        }
                        else
                        {
                            <span class="menu-status">
                                Tersedia
                            </span>
                        }
                    </div>

                    <div class="menu-card-body">

                        <span class="menu-category">
                            @(item.Kategori?.NamaKategori ?? "Tanpa Kategori")
                        </span>

                        <h5 class="menu-name">
                            @item.NamaMenu
                        </h5>

                        <div class="menu-price">
                            @item.Harga.ToString("C0", budayaRupiah)
                        </div>

                        <div class="menu-stock">
                            <i class="bi bi-box-seam me-1"></i>

                            @if (item.Stok <= 0)
                            {
                                <span class="stock-habis">Stok Habis</span>
                            }
                            else
                            {
                                <span>Stok: @item.Stok</span>
                            }
                        </div>

                        @if (User.IsInRole("Manager"))
                        {
                            <div class="menu-actions">

                                @* MENU NONAKTIF: HANYA TOMBOL TERSEDIA *@
                                @if (!item.StatusTersedia)
                                {
                                    <form asp-controller="Menu"
                                          asp-action="Delete"
                                          asp-route-id="@item.IdMenu"
                                          method="post"
                                          onsubmit="return confirm('Aktifkan kembali menu ini?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Tersedia
                                        </button>
                                    </form>
                                }
                                @* MENU AKTIF: EDIT DAN HAPUS, TERMASUK SAAT STOK HABIS *@
                                else
                                {
                                    <a asp-controller="Menu"
                                       asp-action="Edit"
                                       asp-route-id="@item.IdMenu"
                                       class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit
                                    </a>

                                    <form asp-controller="Menu"
                                          asp-action="Delete"
                                          asp-route-id="@item.IdMenu"
                                          method="post"
                                          onsubmit="return confirm('Nonaktifkan menu ini?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash me-1"></i>
                                            Hapus
                                        </button>
                                    </form>
                                }

                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="menu-no-result mt-3" id="menuTidakDitemukan">
            <i class="bi bi-search fs-1"></i>
            <h5 class="mt-3">Menu Tidak Ditemukan</h5>
            <p class="mb-0">
                Coba gunakan kata pencarian atau kategori lain.
            </p>
        </div>
    }
    else
    {
        <div class="menu-empty">
            <i class="bi bi-cup-hot"></i>
            <h5>Belum Ada Menu</h5>
            <p>
                Tambahkan menu makanan atau minuman agar tampil di katalog.
            </p>

            @if (User.IsInRole("Manager"))
            {
                <a asp-controller="Menu"
                   asp-action="Create"
                   class="btn btn-success btn-lg mt-2">
                    <i class="bi bi-plus-circle me-1"></i>
                    Tambah Menu Pertama
                </a>
            }
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputCari = document.getElementById("cariMenu");
        const filterKategori = document.getElementById("filterKategori");
        const kartuMenu = document.querySelectorAll("[data-menu-card]");
        const pesanKosong = document.getElementById("menuTidakDitemukan");

        if (!inputCari || !filterKategori) {
            return;
        }

        function filterMenu() {
            const kataKunci = inputCari.value.toLowerCase().trim();
            const kategoriDipilih = filterKategori.value.toLowerCase();

            let jumlahTampil = 0;

            kartuMenu.forEach(function (kartu) {
                const nama = (kartu.dataset.nama || "").toLowerCase();
                const kategori = (kartu.dataset.kategori || "").toLowerCase();

                const cocokNama = nama.includes(kataKunci);
                const cocokKategori =
                    kategoriDipilih === "" || kategori === kategoriDipilih;

                const tampil = cocokNama && cocokKategori;

                kartu.style.display = tampil ? "" : "none";

                if (tampil) {
                    jumlahTampil++;
                }
            });

            if (pesanKosong) {
                pesanKosong.style.display =
                    jumlahTampil === 0 ? "block" : "none";
            }
        }

        inputCari.addEventListener("input", filterMenu);
        filterKategori.addEventListener("change", filterMenu);
    });
</script>
