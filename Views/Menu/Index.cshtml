
@model IEnumerable<SistemInformasiRestoran.Models.Menu>

@{
    ViewData["Title"] = "Data Menu";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2>Data Menu</h2>
            <p class="text-muted mb-0">
                Kelola daftar makanan dan minuman restoran.
            </p>
        </div>

        @if (User.IsInRole("Manager"))
        {
            <a asp-controller="Menu" asp-action="Create"
               class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> Tambah Menu
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Tutup"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Tutup"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Foto</th>
                                <th>Nama Menu</th>
                                <th>Kategori</th>
                                <th>Harga</th>
                                <th>Stok</th>
                                <th>Status</th>
                                @if (User.IsInRole("Manager"))
                                {
                                    <th>Aksi</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Gambar))
                                        {
                                            <img src="@Url.Content("~/uploads/menu/" + item.Gambar)"
                                                 alt="Foto @item.NamaMenu"
                                                 loading="lazy"
                                                 style="width:76px;height:64px;object-fit:cover;border-radius:10px;" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center bg-light text-secondary"
                                                 style="width:76px;height:64px;border-radius:10px;">
                                                <i class="bi bi-image fs-3"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-semibold">@item.NamaMenu</td>
                                    <td>@(item.Kategori?.NamaKategori ?? "-")</td>
                                    <td>@item.Harga.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("id-ID"))</td>
                                    <td>@item.Stok</td>
                                    <td>
                                        @if (item.StatusTersedia)
                                        {
                                            <span class="badge bg-success">Tersedia</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tidak Tersedia</span>
                                        }
                                    </td>

                                    @if (User.IsInRole("Manager"))
                                    {
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-controller="Menu"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.IdMenu"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Edit menu">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <form asp-controller="Menu"
                                                      asp-action="Delete"
                                                      asp-route-id="@item.IdMenu"
                                                      method="post"
                                                      onsubmit="return confirm('Yakin ingin menghapus menu ini?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Hapus menu">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-cup-hot fs-1 text-secondary"></i>
                    <h5 class="mt-3">Belum Ada Menu</h5>
                    <p class="text-muted">
                        Tambahkan menu makanan atau minuman untuk mulai mengisi daftar.
                    </p>

                    @if (User.IsInRole("Manager"))
                    {
                        <a asp-controller="Menu" asp-action="Create"
                           class="btn btn-success">
                            Tambah Menu Pertama
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
