
@model SistemInformasiRestoran.Models.Kategori

@{
    ViewData["Title"] = "Tambah Kategori";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2>Tambah Kategori</h2>
        <p class="text-muted">Tambahkan kelompok makanan atau minuman.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-controller="Kategori" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="NamaKategori" class="form-label">
                        Nama Kategori
                    </label>
                    <input asp-for="NamaKategori"
                           class="form-control"
                           placeholder="Contoh: Makanan" />
                    <span asp-validation-for="NamaKategori"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Simpan Kategori
                    </button>
                    <a asp-controller="Kategori" asp-action="Index"
                       class="btn btn-outline-secondary">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
