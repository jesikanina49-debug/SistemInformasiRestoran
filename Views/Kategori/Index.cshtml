
@model IEnumerable<SistemInformasiRestoran.Models.Kategori>

@{
    ViewData["Title"] = "Data Kategori";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2>Data Kategori</h2>
            <p class="text-muted mb-0">
                Kelola kategori makanan dan minuman restoran.
            </p>
        </div>

        @if (User.IsInRole("Manager"))
        {
            <a asp-controller="Kategori" asp-action="Create"
               class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> Tambah Kategori
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Tutup"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Tutup"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Nama Kategori</th>
                                @if (User.IsInRole("Manager"))
                                {
                                    <th>Aksi</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int nomor = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@nomor</td>
                                    <td class="fw-semibold">@item.NamaKategori</td>

                                    @if (User.IsInRole("Manager"))
                                    {
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-controller="Kategori"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.IdKategori"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Edit kategori">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <form asp-controller="Kategori"
                                                      asp-action="Delete"
                                                      asp-route-id="@item.IdKategori"
                                                      method="post"
                                                      onsubmit="return confirm('Yakin ingin menghapus kategori ini?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Hapus kategori">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                                nomor++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-tags fs-1 text-secondary"></i>
                    <h5 class="mt-3">Belum Ada Kategori</h5>
                    <p class="text-muted">
                        Tambahkan kategori agar menu dapat dikelompokkan.
                    </p>

                    @if (User.IsInRole("Manager"))
                    {
                        <a asp-controller="Kategori" asp-action="Create"
                           class="btn btn-success">
                            Tambah Kategori Pertama
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
