
@model SistemInformasiRestoran.Models.Kategori

@{
    ViewData["Title"] = "Edit Kategori";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2>Edit Kategori</h2>
        <p class="text-muted">Ubah nama kategori menu restoran.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-controller="Kategori" asp-action="Edit"
                  asp-route-id="@Model.IdKategori" method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdKategori" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="NamaKategori" class="form-label">
                        Nama Kategori
                    </label>
                    <input asp-for="NamaKategori" class="form-control" />
                    <span asp-validation-for="NamaKategori"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Simpan Perubahan
                    </button>

                    <a asp-controller="Kategori" asp-action="Index"
                       class="btn btn-outline-secondary">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
