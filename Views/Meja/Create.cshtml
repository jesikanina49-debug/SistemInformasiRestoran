
@model SistemInformasiRestoran.Models.Meja

@{
    ViewData["Title"] = "Tambah Meja";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2>Tambah Meja</h2>
        <p class="text-muted">Masukkan nomor meja dan jumlah kursinya.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NomorMeja" class="form-label">
                        Nomor Meja
                    </label>
                    <input asp-for="NomorMeja"
                           class="form-control"
                           placeholder="Contoh: Meja 01" />
                    <span asp-validation-for="NomorMeja"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JumlahKursi" class="form-label">
                        Jumlah Kursi
                    </label>
                    <input asp-for="JumlahKursi"
                           type="number"
                           min="1"
                           max="50"
                           class="form-control" />
                    <span asp-validation-for="JumlahKursi"
                          class="text-danger"></span>
                    <small class="text-muted">
                        Contoh: 4 kursi untuk satu meja.
                    </small>
                </div>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Meja baru otomatis memiliki status Tersedia.
                    Status akan berubah otomatis ketika ada pesanan.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Simpan
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Kembali
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
