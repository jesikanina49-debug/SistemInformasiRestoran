
@model IEnumerable<SistemInformasiRestoran.Models.Meja>

@{
    ViewData["Title"] = "Denah Meja";
    var daftarMeja = Model.OrderBy(m => m.NomorMeja).ToList();
}

<div class="container-fluid meja-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold">Denah Meja Restoran</h2>
            <p class="text-muted mb-0">Pantau kondisi meja dan kapasitas restoran.</p>
        </div>

        @if (User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Meja
            </a>
        }
    </div>

    <!-- NOTIFIKASI -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            <i class="bi bi-info-circle-fill"></i>
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- RINGKASAN -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card summary-card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Total Meja</small>
                    <h3 class="fw-bold mb-0">@daftarMeja.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card summary-card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Meja Kosong</small>
                    <h3 class="fw-bold text-success mb-0">
                        @daftarMeja.Count(m => m.StatusMeja == "Tersedia")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card summary-card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Meja Terisi</small>
                    <h3 class="fw-bold text-danger mb-0">
                        @daftarMeja.Count(m => m.StatusMeja == "Digunakan")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- KETERANGAN -->
    <div class="d-flex gap-3 mb-3 flex-wrap">
        <span class="badge bg-success p-2">
            <i class="bi bi-circle-fill"></i> Kosong
        </span>

        <span class="badge bg-danger p-2">
            <i class="bi bi-circle-fill"></i> Terisi
        </span>
    </div>

    <!-- DENAH MEJA -->
    <div class="row g-3">
        @foreach (var meja in daftarMeja)
        {
            bool tersedia = meja.StatusMeja == "Tersedia";

            <div class="col-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100 meja-card @(tersedia ? "meja-kosong" : "meja-terisi")">
                    <div class="card-body">

                        <!-- NAMA DAN STATUS MEJA -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-grid-3x3-gap"></i>
                                @meja.NomorMeja
                            </h5>

                            @if (tersedia)
                            {
                                <span class="badge bg-success">Kosong</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Terisi</span>
                            }
                        </div>

                        <!-- KURSI ATAS -->
                        <div class="d-flex justify-content-center gap-3 mb-1">
                            @for (int i = 0; i < (meja.JumlahKursi + 1) / 2; i++)
                            {
                                <i class="bi bi-person-fill kursi-icon"></i>
                            }
                        </div>

                        <!-- MEJA -->
                        <div class="meja-tengah">
                            <i class="bi bi-table meja-icon"></i>

                            <h6 class="fw-bold mt-1 mb-0">
                                @meja.NomorMeja
                            </h6>

                            <small>@meja.JumlahKursi Kursi</small>
                        </div>

                        <!-- KURSI BAWAH -->
                        <div class="d-flex justify-content-center gap-3 mt-1">
                            @for (int i = 0; i < meja.JumlahKursi / 2; i++)
                            {
                                <i class="bi bi-person-fill kursi-icon"></i>
                            }
                        </div>

                        <hr class="my-2" />

                        <!-- INFORMASI WAKTU -->
                        @if (!tersedia && meja.MulaiDigunakan.HasValue)
                        {
                            <p class="text-muted info-meja mb-2">
                                <i class="bi bi-clock"></i>
                                Mulai:
                                <strong>@meja.MulaiDigunakan.Value.ToString("HH:mm")</strong>
                            </p>
                        }
                        else
                        {
                            <p class="text-success info-meja mb-2">
                                <i class="bi bi-check-circle"></i>
                                Meja siap digunakan
                            </p>
                        }

                        <!-- AKSI MANAGER -->
                        @if (User.IsInRole("Manager"))
                        {
                            <div class="d-flex gap-2 mt-2">
                                <a asp-action="Edit"
                                   asp-route-id="@meja.IdMeja"
                                   class="btn btn-warning btn-sm flex-fill">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@meja.IdMeja"
                                      method="post"
                                      class="flex-fill"
                                      onsubmit="return confirm('Yakin ingin menghapus meja ini?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-danger btn-sm w-100">
                                        <i class="bi bi-trash"></i> Hapus
                                    </button>
                                </form>
                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    </div>

    @if (!daftarMeja.Any())
    {
        <div class="alert alert-info mt-3">
            Belum ada meja. Silakan tambahkan data meja terlebih dahulu.
        </div>
    }

</div>

<style>
    .meja-page {
        padding: 8px 4px 30px;
    }

    .summary-card {
        border-radius: 12px;
    }

    .summary-card .card-body {
        padding: 15px 18px;
    }

    .meja-card {
        border-radius: 12px;
        transition: 0.2s ease;
        border: 2px solid transparent;
    }

    .meja-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 18px rgba(0,0,0,.09) !important;
    }

    .meja-kosong {
        border-color: #198754;
    }

    .meja-terisi {
        border-color: #dc3545;
    }

    .meja-card .card-body {
        padding: 13px;
    }

    .meja-tengah {
        background: #e9ecef;
        border-radius: 11px;
        min-height: 82px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #495057;
    }

    .meja-terisi .meja-tengah {
        background: #f8d7da;
        color: #842029;
    }

    .meja-kosong .meja-tengah {
        background: #d1e7dd;
        color: #0f5132;
    }

    .meja-icon {
        font-size: 27px;
    }

    .kursi-icon {
        font-size: 20px;
        color: #6c757d;
    }

    .info-meja {
        font-size: 12px;
        min-height: 20px;
    }

    .meja-card .badge {
        font-size: 10px;
    }

    .meja-card .btn {
        font-size: 12px;
    }

    @@media (max-width: 576px) {
        .meja-card .card-body {
            padding: 10px;
        }

        .meja-card h5 {
            font-size: 14px;
        }

        .meja-tengah {
            min-height: 72px;
        }

        .kursi-icon {
            font-size: 17px;
        }

        .meja-icon {
            font-size: 23px;
        }

        .meja-card .btn {
            font-size: 11px;
            padding: 5px 3px;
        }
    }
</style>
