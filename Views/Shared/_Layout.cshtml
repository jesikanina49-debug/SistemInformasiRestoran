
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RESTO POS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemInformasiRestoran.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="resto-body">

    <div class="resto-layout">
        <aside class="resto-sidebar">
            <a class="resto-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-fork-knife"></i>
                <span>
                    <strong>RESTO POS</strong>
                    <small>Mudah · Cepat · Akurat</small>
                </span>
            </a>

            <nav class="resto-nav">
                <a asp-controller="Home" asp-action="Index" class="resto-nav-link">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="resto-nav-link">
                    <i class="bi bi-cart-fill"></i>
                    <span>Pemesanan</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="resto-nav-link">
                    <i class="bi bi-journal-richtext"></i>
                    <span>Data Menu</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="resto-nav-link">
                    <i class="bi bi-tags-fill"></i>
                    <span>Kategori Menu</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="resto-nav-link">
                    <i class="bi bi-shop"></i>
                    <span>Data Meja</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="resto-nav-link">
                    <i class="bi bi-credit-card-fill"></i>
                    <span>Pembayaran</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="resto-nav-link">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Laporan</span>
                </a>
            </nav>

            <div class="resto-sidebar-bottom">
                <i class="bi bi-emoji-smile"></i>
                <p>Rasa Lezat<br />Pelayanan Cepat</p>
            </div>
        </aside>

        <div class="resto-main">
            <header class="resto-topbar">
                <span class="resto-topbar-title">Sistem Informasi Restoran</span>
                <div class="resto-user">
                    <i class="bi bi-person-circle"></i>
                    <span>Kasir</span>
                </div>
            </header>

            <main class="resto-content">
                @RenderBody()
            </main>

            <footer class="resto-footer">
                &copy; 2026 RESTO POS · Sistem Informasi Restoran
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
