
@model IEnumerable<SistemInformasiRestoran.Models.AuditTrail>

@{
    ViewData["Title"] = "Audit Trail";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Audit Trail</h2>
            <p class="text-muted mb-0">
                Riwayat aktivitas pengguna dalam sistem RESTO POS.
            </p>
        </div>
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Kembali
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-controller="AuditTrail"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Pencarian</label>
                        <input type="text"
                               name="pencarian"
                               value="@ViewBag.Pencarian"
                               class="form-control"
                               placeholder="Nama pengguna, aktivitas, tabel..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Tanggal Mulai</label>
                        <input type="date"
                               name="tanggalMulai"
                               value="@ViewBag.TanggalMulai"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Tanggal Akhir</label>
                        <input type="date"
                               name="tanggalAkhir"
                               value="@ViewBag.TanggalAkhir"
                               class="form-control" />
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Cari
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-clock-history"></i>
                Riwayat Aktivitas
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">No.</th>
                            <th>Waktu</th>
                            <th>Pengguna</th>
                            <th>Aktivitas</th>
                            <th>Nama Tabel</th>
                            <th>ID Data</th>
                            <th>Keterangan</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            int nomor = 1;

                            foreach (var audit in Model)
                            {
                                <tr>
                                    <td class="ps-3">@nomor</td>

                                    <td>
                                        <div>
                                            @audit.TanggalAktivitas.ToString("dd/MM/yyyy")
                                        </div>
                                        <small class="text-muted">
                                            @audit.TanggalAktivitas.ToString("HH:mm:ss")
                                        </small>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @audit.NamaUser
                                        </span>
                                        <br />
                                        <small class="text-muted">
                                            ID: @(audit.IdUser?.ToString() ?? "-")
                                        </small>
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @audit.Aktivitas
                                        </span>
                                    </td>

                                    <td>@audit.NamaTabel</td>

                                    <td>@(audit.IdData?.ToString() ?? "-")</td>

                                    <td>
                                        <small>
                                            @(audit.Keterangan ?? "-")
                                        </small>
                                    </td>
                                </tr>

                                nomor++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Belum ada riwayat aktivitas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white text-muted">
            Menampilkan maksimal 500 catatan aktivitas terbaru.
        </div>
    </div>
</div>
