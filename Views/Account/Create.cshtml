
@{
    ViewData["Title"] = "Tambah Akun";
}

<div class="container-fluid px-0">

    <div class="mb-4">
        <span class="badge rounded-pill mb-2"
              style="background: #e3efe6; color: #073e32;">
            <i class="bi bi-person-plus me-1"></i>
            Manajemen Pengguna
        </span>

        <h2 class="fw-bold mb-1">Tambah Akun</h2>

        <p class="text-secondary mb-0">
            Tambahkan akun Manager atau Kasir untuk menggunakan RESTO POS.
        </p>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="resto-card-icon">
                            <i class="bi bi-person-plus"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Formulir Akun Baru</h5>
                            <small class="text-secondary">
                                Isi informasi akun dengan benar.
                            </small>
                        </div>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="Account"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Nama Lengkap
                            </label>

                            <input type="text"
                                   name="nama"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Masukkan nama lengkap"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Username
                            </label>

                            <input type="text"
                                   name="username"
                                   class="form-control"
                                   maxlength="50"
                                   placeholder="Masukkan username"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Password
                            </label>

                            <input type="password"
                                   name="password"
                                   class="form-control"
                                   minlength="12"
                                   placeholder="Minimal 12 karakter"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Konfirmasi Password
                            </label>

                            <input type="password"
                                   name="konfirmasiPassword"
                                   class="form-control"
                                   minlength="12"
                                   placeholder="Masukkan ulang password"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Hak Akses / Role
                            </label>

                            <select name="role"
                                    class="form-select"
                                    required>
                                <option value="">Pilih Role</option>
                                <option value="Kasir">Kasir</option>
                                <option value="Manager">Manager</option>
                            </select>

                            <small class="text-secondary">
                                Manager memiliki akses pengelolaan,
                                sedangkan Kasir menggunakan fitur operasional.
                            </small>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn px-4"
                                    style="background: #073e32; color: white;">
                                <i class="bi bi-person-plus me-2"></i>
                                Simpan Akun
                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Kembali
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>

        <div class="col-12 col-lg-4 mt-4 mt-lg-0">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <div class="resto-card-icon mb-3">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <h5 class="fw-bold">Informasi Hak Akses</h5>

                    <div class="mt-3">
                        <p class="fw-semibold mb-1">
                            <i class="bi bi-person-gear me-2"
                               style="color: #176c53;"></i>
                            Manager
                        </p>

                        <small class="text-secondary">
                            Mengelola data restoran, akun pengguna,
                            transaksi, dan laporan.
                        </small>
                    </div>

                    <hr />

                    <div>
                        <p class="fw-semibold mb-1">
                            <i class="bi bi-person-workspace me-2"
                               style="color: #176c53;"></i>
                            Kasir
                        </p>

                        <small class="text-secondary">
                            Menjalankan kegiatan operasional,
                            pemesanan, dan pembayaran.
                        </small>
                    </div>

                    <hr />

                    <small class="text-secondary">
                        <i class="bi bi-info-circle me-1"></i>
                        Password akan disimpan dalam bentuk hash
                        untuk menjaga keamanan akun.
                    </small>

                </div>
            </div>

        </div>
    </div>

</div>
