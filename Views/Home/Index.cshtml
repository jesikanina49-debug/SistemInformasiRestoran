
@model SistemInformasiRestoran.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var budayaRupiah = System.Globalization.CultureInfo.GetCultureInfo("id-ID");
}

<div class="container-fluid px-0">

    <!-- Header Dashboard -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge rounded-pill mb-2"
                  style="background: #e3efe6; color: #073e32;">
                <i class="bi bi-grid-1x2 me-1"></i>
                Ringkasan Restoran
            </span>

            <h2 class="fw-bold mb-1">Dashboard</h2>

            <p class="text-secondary mb-0">
                Selamat datang di RESTO POS. Kelola restoran dengan mudah,
                cepat, dan akurat.
            </p>
        </div>

        <div class="resto-date">
            <i class="bi bi-calendar3 me-2"></i>
            @DateTime.Now.ToString("dd MMMM yyyy", budayaRupiah)
        </div>
    </div>

    <!-- Kartu Ringkasan -->
    <div class="row g-4">

        <!-- Total Menu -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card resto-hover-card resto-card-green h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 text-secondary">Total Menu</p>
                            <h2 class="fw-bold mb-1">@Model.TotalMenu</h2>
                            <small class="text-secondary">Menu terdaftar</small>
                        </div>

                        <div class="resto-card-icon">
                            <i class="bi bi-cup-hot"></i>
                        </div>
                    </div>

                    <div class="mt-4 small">
                        <i class="bi bi-arrow-right-circle me-1"></i>
                        <a asp-controller="Menu"
                           asp-action="Index"
                           class="text-decoration-none fw-semibold"
                           style="color: #073e32;">
                            Lihat Data Menu
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Meja -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card resto-hover-card resto-card-sage h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 text-secondary">Total Meja</p>
                            <h2 class="fw-bold mb-1">@Model.TotalMeja</h2>
                            <small class="text-secondary">Meja restoran</small>
                        </div>

                        <div class="resto-card-icon">
                            <i class="bi bi-shop"></i>
                        </div>
                    </div>

                    <div class="mt-4 small">
                        <i class="bi bi-grid me-1"></i>
                        <span class="text-secondary">Data meja terdaftar</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pesanan Hari Ini -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card resto-hover-card resto-card-cream h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 text-secondary">Pesanan Hari Ini</p>
                            <h2 class="fw-bold mb-1">@Model.PesananHariIni</h2>
                            <small class="text-secondary">Seluruh pesanan</small>
                        </div>

                        <div class="resto-card-icon">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>

                    <div class="mt-4 small">
                        <i class="bi bi-clock me-1"></i>
                        <span class="text-secondary">Transaksi harian</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pendapatan Hari Ini -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card resto-hover-card resto-card-peach h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 text-secondary">Pendapatan Hari Ini</p>
                            <h2 class="fw-bold mb-1" style="font-size: 1.5rem;">
                                @Model.PendapatanHariIni.ToString("C0", budayaRupiah)
                            </h2>
                            <small class="text-secondary">Pembayaran berhasil</small>
                        </div>

                        <div class="resto-card-icon">
                            <i class="bi bi-wallet2"></i>
                        </div>
                    </div>

                    <div class="mt-4 small">
                        <i class="bi bi-cash-stack me-1"></i>
                        <span class="text-secondary">Omzet harian</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Ringkasan Keuangan -->
    <div class="row g-4 mt-1">

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-2">Total Penghasilan</p>
                    <h4 class="fw-bold mb-1" style="color: #176c53;">
                        @Model.TotalPendapatan.ToString("C0", budayaRupiah)
                    </h4>
                    <small class="text-secondary">Akumulasi seluruh pembayaran</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-2">Total Transaksi</p>
                    <h4 class="fw-bold mb-1">@Model.TotalTransaksi</h4>
                    <small class="text-secondary">Pembayaran tercatat</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-2">Menu Terjual</p>
                    <h4 class="fw-bold mb-1">@Model.MenuTerjual</h4>
                    <small class="text-secondary">Total item dari pesanan dibayar</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Aktivitas dan Akses Cepat -->
    <div class="row g-4 mt-1">

        <div class="col-12 col-lg-7">
            <div class="card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="resto-card-icon">
                            <i class="bi bi-activity"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Aktivitas Pembayaran Terbaru</h5>
                            <p class="text-secondary small mb-0">
                                Lima pembayaran terakhir
                            </p>
                        </div>
                    </div>

                    @if (Model.AktivitasTerbaru.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Tanggal</th>
                                        <th>Meja</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var aktivitas in Model.AktivitasTerbaru)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold">
                                                    @aktivitas.TanggalPembayaran.ToString("dd/MM/yyyy")
                                                </span>
                                                <br />
                                                <small class="text-secondary">
                                                    @aktivitas.TanggalPembayaran.ToString("HH:mm")
                                                </small>
                                            </td>
                                            <td>
                                                @(aktivitas.Pesanan?.Meja?.NomorMeja ?? "-")
                                            </td>
                                            <td class="fw-semibold">
                                                @aktivitas.TotalBayar.ToString("C0", budayaRupiah)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-3 p-4 text-center"
                             style="background: #f4f5ee;">
                            <i class="bi bi-clipboard-data display-5"
                               style="color: #176c53;"></i>

                            <p class="fw-semibold mt-3 mb-1">
                                Belum ada pembayaran
                            </p>

                            <p class="text-secondary small mb-0">
                                Aktivitas pembayaran akan muncul setelah transaksi berhasil dilakukan.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="resto-card-icon">
                            <i class="bi bi-lightning-charge"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Akses Cepat</h5>
                            <p class="text-secondary small mb-0">
                                Menu yang sering digunakan
                            </p>
                        </div>
                    </div>

                    <div class="d-grid gap-3">
                        <a asp-controller="Menu"
                           asp-action="Index"
                           class="resto-quick-link">
                            <i class="bi bi-cup-hot"></i>
                            <span>
                                <strong>Data Menu</strong>
                                <small>Kelola makanan dan minuman</small>
                            </span>
                            <i class="bi bi-chevron-right ms-auto"></i>
                        </a>

                        <a asp-controller="Pemesanan"
                           asp-action="Index"
                           class="resto-quick-link">
                            <i class="bi bi-cart3"></i>
                            <span>
                                <strong>Pemesanan</strong>
                                <small>Kelola pesanan pelanggan</small>
                            </span>
                            <i class="bi bi-chevron-right ms-auto"></i>
                        </a>

                        <a asp-controller="Laporan"
                           asp-action="Index"
                           class="resto-quick-link">
                            <i class="bi bi-bar-chart"></i>
                            <span>
                                <strong>Laporan</strong>
                                <small>Lihat laporan omzet restoran</small>
                            </span>
                            <i class="bi bi-chevron-right ms-auto"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Grafik Omzet -->
    <div class="card mt-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="resto-card-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">Omzet 7 Hari Terakhir</h5>
                    <p class="text-secondary small mb-0">
                        Ringkasan pendapatan berdasarkan pembayaran
                    </p>
                </div>
            </div>

            <div class="row g-3 align-items-end">
                @foreach (var item in Model.GrafikOmzet)
                {
                    var omzetMaksimal = Model.GrafikOmzet.Any()
                        ? Model.GrafikOmzet.Max(x => x.TotalOmzet)
                        : 0;

                    var tinggi = omzetMaksimal > 0
                        ? (double)(item.TotalOmzet / omzetMaksimal) * 100
                        : 0;

                    <div class="col">
                        <div class="text-center small fw-semibold mb-2">
                            @item.TotalOmzet.ToString("N0", budayaRupiah)
                        </div>

                        <div class="d-flex align-items-end justify-content-center rounded-3"
                             style="height: 150px; background: #f4f5ee;">
                            <div class="w-75 rounded-top-3"
                                 style="height: @(tinggi)% ; min-height: @(item.TotalOmzet > 0 ? "5px" : "0"); background: #176c53;">
                            </div>
                        </div>

                        <div class="text-center small text-secondary mt-2">
                            @item.Tanggal.ToString("dd/MM")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<style>
    .resto-date {
        padding: 10px 15px;
        border: 1px solid #e2e7df;
        border-radius: 10px;
        background: #fffefa;
        color: #31564b;
        font-size: 0.9rem;
    }

    .resto-quick-link {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px;
        border: 1px solid #e2e7df;
        border-radius: 12px;
        color: #183c3b;
        background: #fffefa;
        text-decoration: none;
        transition: background-color 0.22s ease,
                    border-color 0.22s ease,
                    transform 0.22s ease,
                    box-shadow 0.22s ease;
    }

    .resto-quick-link > i:first-child {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e3efe6;
        color: #073e32;
        font-size: 21px;
    }

    .resto-quick-link span {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .resto-quick-link small {
        color: #687b76;
    }

    .resto-quick-link:hover {
        background: #f0f5ee;
        border-color: #b8d2bf;
        color: #073e32;
        transform: translateX(3px);
        box-shadow: 0 5px 12px rgba(7, 62, 50, 0.08);
    }

    @@media (prefers-reduced-motion: reduce) {
        .resto-quick-link {
            transition: none;
        }
    }
</style>
