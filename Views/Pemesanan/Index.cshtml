
@model SistemInformasiRestoran.Models.ViewModels.PemesananViewModel

@{
    ViewData["Title"] = "Pemesanan";
}

<div class="container-fluid py-3">

    <div class="mb-4">
        <h2 class="fw-bold">Pemesanan Menu</h2>
        <p class="text-muted">Pilih meja dan tambahkan makanan atau minuman ke pesanan.</p>
    </div>

    <div id="pesanAjax"></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    
        <!-- PILIH MEJA -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Pilih Meja</h5>

                <div class="d-flex flex-wrap gap-2">
                    @foreach (var meja in Model.DaftarMeja)
                    {
                        <a asp-controller="Pemesanan"
                        asp-action="Index"
                        asp-route-idMeja="@meja.IdMeja"
                        class="btn @(Model.MejaDipilih?.IdMeja == meja.IdMeja ? "btn-primary" : "btn-outline-primary")"
                        onclick="@(meja.StatusMeja == "Digunakan" ? "return confirm('Meja ini sedang terisi dan masih memiliki pesanan yang belum dibayar. Apakah Anda ingin melanjutkan dan menambahkan pesanan ke tagihan yang sama?')" : null)">

                            @meja.NomorMeja

                            @if (meja.StatusMeja == "Digunakan")
                            {
                                <span class="badge bg-warning text-dark ms-1">
                                    Terisi
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success ms-1">
                                    Tersedia
                                </span>
                            }
                        </a>
                    }
                </div>

                @if (Model.MejaDipilih != null)
                {
                    <div class="alert alert-primary mt-3 mb-0">
                        Meja dipilih:
                        <strong>@Model.MejaDipilih.NomorMeja</strong>
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3 mb-0">
                        Silakan pilih meja terlebih dahulu.
                    </p>
                }
            </div>
        </div>

    @if (Model.MejaDipilih != null)
    {
        <div class="row g-4">

            <!-- DAFTAR MENU -->
            <div class="col-lg-8">
                <h5 class="fw-bold mb-3">Daftar Menu</h5>

                @if (!Model.DaftarMenu.Any())
                {
                    <div class="alert alert-warning">
                        Belum ada menu yang tersedia atau stok sedang habis.
                    </div>
                }
                else
                {
                    <div class="row g-3">

                        @foreach (var menu in Model.DaftarMenu)
                        {
                            <div class="col-6 col-md-4 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">

                                    @if (!string.IsNullOrWhiteSpace(menu.Gambar))
                                    {
                                        <img src="@Url.Content("~/uploads/menu/" + menu.Gambar)"
                                             class="card-img-top"
                                             alt="Foto @menu.NamaMenu"
                                             style="height:180px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center"
                                             style="height:180px;">
                                            <span class="text-muted">Tidak ada foto</span>
                                        </div>
                                    }

                                    <div class="card-body d-flex flex-column">

                                        <h6 class="fw-bold">@menu.NamaMenu</h6>

                                        <small class="text-muted mb-2">
                                            @(menu.Kategori?.NamaKategori ?? "Tanpa Kategori")
                                        </small>

                                        <div class="text-primary fw-bold mb-2">
                                            Rp @menu.Harga.ToString("N0")
                                        </div>

                                        <small class="text-muted mb-3"
                                               data-stok-menu="@menu.IdMenu">
                                            Stok: @menu.Stok
                                        </small>

                                        <form asp-controller="Pemesanan"
                                              asp-action="Tambah"
                                              method="post"
                                              class="mt-auto js-add-form"
                                              data-nama-menu="@menu.NamaMenu"
                                              data-harga-menu="@menu.Harga.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="idMeja"
                                                   value="@Model.MejaDipilih.IdMeja" />

                                            <input type="hidden"
                                                   name="idMenu"
                                                   value="@menu.IdMenu" />

                                            <input type="hidden"
                                                   name="jumlah"
                                                   value="1" />

                                            <button type="submit"
                                                    class="btn btn-primary btn-sm w-100"
                                                    disabled="@(menu.Stok <= 0)">
                                                <i class="bi bi-plus-circle"></i>
                                                Tambah
                                            </button>
                                        </form>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- KERANJANG -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">

                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-cart3"></i>
                            Keranjang Pesanan
                        </h5>

                        <p class="text-muted small">
                            @Model.MejaDipilih.NomorMeja
                        </p>

                        <div id="keranjangPesanan">

                            @if (!Model.Keranjang.Any())
                            {
                                <div class="text-center py-4" id="keranjangKosong">
                                    <i class="bi bi-cart-x fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">
                                        Keranjang masih kosong.
                                    </p>
                                </div>
                            }
                            else
                            {
                                @foreach (var item in Model.Keranjang)
                                {
                                    <div class="border-bottom py-3"
                                         data-cart-item
                                         data-id-menu="@item.IdMenu">

                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <div class="fw-semibold" data-nama-item>
                                                    @item.NamaMenu
                                                </div>

                                                <small class="text-muted" data-harga-item>
                                                    Rp @item.Harga.ToString("N0")
                                                </small>
                                            </div>

                                            <div class="fw-bold" data-subtotal>
                                                Rp @item.Subtotal.ToString("N0")
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mt-3">

                                            <div class="d-flex align-items-center gap-2">

                                                <!-- KURANGI -->
                                                <form asp-action="UbahJumlah"
                                                      method="post"
                                                      class="js-quantity-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="idMeja"
                                                           value="@Model.MejaDipilih.IdMeja" />

                                                    <input type="hidden"
                                                           name="idMenu"
                                                           value="@item.IdMenu" />

                                                    <input type="hidden"
                                                           name="jumlah"
                                                           value="@(item.Jumlah - 1)" />

                                                    <button type="submit"
                                                            class="btn btn-outline-secondary btn-sm"
                                                            title="Kurangi jumlah">
                                                        <i class="bi bi-dash-lg"></i>
                                                    </button>
                                                </form>

                                                <span class="fw-bold px-2" data-jumlah>
                                                    @item.Jumlah
                                                </span>

                                                <!-- TAMBAH JUMLAH -->
                                                <form asp-action="UbahJumlah"
                                                      method="post"
                                                      class="js-quantity-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="idMeja"
                                                           value="@Model.MejaDipilih.IdMeja" />

                                                    <input type="hidden"
                                                           name="idMenu"
                                                           value="@item.IdMenu" />

                                                    <input type="hidden"
                                                           name="jumlah"
                                                           value="@(item.Jumlah + 1)" />

                                                    <button type="submit"
                                                            class="btn btn-outline-primary btn-sm"
                                                            title="Tambah jumlah">
                                                        <i class="bi bi-plus-lg"></i>
                                                    </button>
                                                </form>

                                            </div>

                                            <!-- HAPUS -->
                                            <form asp-action="Hapus" method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="idMeja"
                                                       value="@Model.MejaDipilih.IdMeja" />

                                                <input type="hidden"
                                                       name="idMenu"
                                                       value="@item.IdMenu" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Hapus menu ini dari keranjang?')">
                                                    <i class="bi bi-trash"></i>
                                                    Hapus
                                                </button>
                                            </form>

                                        </div>
                                    </div>
                                }
                            }

                        </div>

                        <!-- TOTAL -->
                        <div class="d-flex justify-content-between mt-4">
                            <h5 class="fw-bold">Total</h5>

                            <h5 class="fw-bold text-primary"
                                id="totalKeranjang"
                                data-total="@Model.Total">
                                Rp @Model.Total.ToString("N0")
                            </h5>
                        </div>

                        <!-- SIMPAN PESANAN -->
                        <form asp-action="Simpan"
                              method="post"
                              class="mt-3"
                              id="formSimpanPesanan">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="idMeja"
                                   value="@Model.MejaDipilih.IdMeja" />

                            <button type="submit"
                                    class="btn btn-success w-100"
                                    id="tombolSimpanPesanan"
                                    disabled="@(!Model.Keranjang.Any())"
                                    onclick="return confirm('Simpan pesanan untuk meja ini?')">
                                <i class="bi bi-save"></i>
                                Simpan Pesanan
                            </button>
                        </form>

                    </div>
                </div>
            </div>

        </div>
    }
</div>

@section Scripts {
    <script>
        const urlUbahJumlah = '@Url.Action("UbahJumlah", "Pemesanan")';
        const urlHapus = '@Url.Action("Hapus", "Pemesanan")';

        function formatRupiah(angka) {
            return new Intl.NumberFormat('id-ID').format(angka);
        }

        function tampilkanPesan(pesan, jenis = 'success') {
            const tempat = document.getElementById('pesanAjax');

            tempat.innerHTML = '';

            const alert = document.createElement('div');
            alert.className = `alert alert-${jenis} alert-dismissible fade show`;
            alert.setAttribute('role', 'alert');

            const teks = document.createElement('span');
            teks.textContent = pesan;

            const tombol = document.createElement('button');
            tombol.type = 'button';
            tombol.className = 'btn-close';
            tombol.setAttribute('data-bs-dismiss', 'alert');

            alert.appendChild(teks);
            alert.appendChild(tombol);
            tempat.appendChild(alert);
        }

        function buatInput(form, nama, nilai) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = nama;
            input.value = nilai;
            form.appendChild(input);
            return input;
        }

        function buatForm(action, token, idMeja, idMenu, jumlah, kelas) {
            const form = document.createElement('form');

            form.method = 'post';
            form.action = action;

            if (kelas) {
                form.className = kelas;
            }

            buatInput(form, '__RequestVerificationToken', token);
            buatInput(form, 'idMeja', idMeja);
            buatInput(form, 'idMenu', idMenu);
            buatInput(form, 'jumlah', jumlah);

            return form;
        }

        function buatItemKeranjang(data, token, idMeja) {
            const item = document.createElement('div');

            item.className = 'border-bottom py-3';
            item.dataset.cartItem = '';
            item.dataset.idMenu = data.idMenu;

            // Informasi menu dan subtotal.
            const bagianAtas = document.createElement('div');
            bagianAtas.className = 'd-flex justify-content-between';

            const informasi = document.createElement('div');

            const nama = document.createElement('div');
            nama.className = 'fw-semibold';
            nama.dataset.namaItem = '';
            nama.textContent = data.namaMenu;

            const harga = document.createElement('small');
            harga.className = 'text-muted';
            harga.dataset.hargaItem = '';
            harga.textContent = 'Rp ' + formatRupiah(data.harga);

            informasi.appendChild(nama);
            informasi.appendChild(harga);

            const subtotal = document.createElement('div');
            subtotal.className = 'fw-bold';
            subtotal.dataset.subtotal = '';
            subtotal.textContent = 'Rp ' + formatRupiah(data.subtotal);

            bagianAtas.appendChild(informasi);
            bagianAtas.appendChild(subtotal);

            // Tombol jumlah.
            const bagianBawah = document.createElement('div');
            bagianBawah.className =
                'd-flex justify-content-between align-items-center mt-3';

            const kontrolJumlah = document.createElement('div');
            kontrolJumlah.className = 'd-flex align-items-center gap-2';

            const formKurang = buatForm(
                urlUbahJumlah,
                token,
                idMeja,
                data.idMenu,
                data.jumlah - 1,
                'js-quantity-form'
            );

            const tombolKurang = document.createElement('button');
            tombolKurang.type = 'submit';
            tombolKurang.className = 'btn btn-outline-secondary btn-sm';
            tombolKurang.title = 'Kurangi jumlah';
            tombolKurang.innerHTML = '<i class="bi bi-dash-lg"></i>';
            formKurang.appendChild(tombolKurang);

            const jumlah = document.createElement('span');
            jumlah.className = 'fw-bold px-2';
            jumlah.dataset.jumlah = '';
            jumlah.textContent = data.jumlah;

            const formTambah = buatForm(
                urlUbahJumlah,
                token,
                idMeja,
                data.idMenu,
                data.jumlah + 1,
                'js-quantity-form'
            );

            const tombolTambah = document.createElement('button');
            tombolTambah.type = 'submit';
            tombolTambah.className = 'btn btn-outline-primary btn-sm';
            tombolTambah.title = 'Tambah jumlah';
            tombolTambah.innerHTML = '<i class="bi bi-plus-lg"></i>';
            formTambah.appendChild(tombolTambah);

            kontrolJumlah.appendChild(formKurang);
            kontrolJumlah.appendChild(jumlah);
            kontrolJumlah.appendChild(formTambah);

            // Tombol hapus.
            const formHapus = document.createElement('form');
            formHapus.method = 'post';
            formHapus.action = urlHapus;

            buatInput(formHapus, '__RequestVerificationToken', token);
            buatInput(formHapus, 'idMeja', idMeja);
            buatInput(formHapus, 'idMenu', data.idMenu);

            const tombolHapus = document.createElement('button');
            tombolHapus.type = 'submit';
            tombolHapus.className = 'btn btn-outline-danger btn-sm';
            tombolHapus.innerHTML =
                '<i class="bi bi-trash"></i> Hapus';

            formHapus.appendChild(tombolHapus);

            formHapus.addEventListener('submit', function (event) {
                if (!confirm('Hapus menu ini dari keranjang?')) {
                    event.preventDefault();
                }
            });

            bagianBawah.appendChild(kontrolJumlah);
            bagianBawah.appendChild(formHapus);

            item.appendChild(bagianAtas);
            item.appendChild(bagianBawah);

            return item;
        }

        function perbaruiJumlahItem(item, jumlah) {
            item.querySelector('[data-jumlah]').textContent = jumlah;

            const semuaForm = item.querySelectorAll('.js-quantity-form');

            semuaForm.forEach(function (form) {
                const input = form.querySelector('input[name="jumlah"]');
                const ikon = form.querySelector('i');

                if (ikon && ikon.classList.contains('bi-dash-lg')) {
                    input.value = jumlah - 1;
                } else {
                    input.value = jumlah + 1;
                }
            });
        }

        function perbaruiStok(idMenu, stok) {
            const labelStok = document.querySelector(
                `[data-stok-menu="${idMenu}"]`
            );

            if (!labelStok) {
                return;
            }

            labelStok.textContent = 'Stok: ' + stok;

            const formTambah = labelStok.parentElement.querySelector(
                '.js-add-form'
            );

            if (!formTambah) {
                return;
            }

            const tombol = formTambah.querySelector('button');

            if (stok <= 0) {
                tombol.disabled = true;
                tombol.innerHTML =
                    '<i class="bi bi-x-circle"></i> Stok Habis';
            } else {
                tombol.disabled = false;
                tombol.innerHTML =
                    '<i class="bi bi-plus-circle"></i> Tambah';
            }
        }

        function perbaruiTotal(total) {
            const totalElement = document.getElementById('totalKeranjang');

            totalElement.textContent = 'Rp ' + formatRupiah(total);
            totalElement.dataset.total = total;
        }

        function perbaruiTampilanKosong() {
            const keranjang = document.getElementById('keranjangPesanan');
            const jumlahItem = keranjang.querySelectorAll('[data-cart-item]').length;

            if (jumlahItem === 0) {
                keranjang.innerHTML = `
                    <div class="text-center py-4" id="keranjangKosong">
                        <i class="bi bi-cart-x fs-1 text-muted"></i>
                        <p class="text-muted mt-2">
                            Keranjang masih kosong.
                        </p>
                    </div>
                `;
            }

            document.getElementById('tombolSimpanPesanan').disabled =
                jumlahItem === 0;
        }

        // AJAX untuk tombol Tambah, +, dan -.
        document.addEventListener('submit', async function (event) {
            const form = event.target.closest(
                '.js-add-form, .js-quantity-form'
            );

            if (!form) {
                return;
            }

            event.preventDefault();

            const tombol = form.querySelector('button[type="submit"]');

            if (tombol.disabled) {
                return;
            }

            tombol.disabled = true;

            const isTambahMenu = form.classList.contains('js-add-form');

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const hasil = await response.json();

                if (!response.ok || !hasil.success) {
                    tampilkanPesan(
                        hasil.message || 'Permintaan gagal diproses.',
                        'danger'
                    );
                    return;
                }

                const idMenu = hasil.idMenu;

                // Perbarui stok pada kartu menu.
                if (typeof hasil.stok === 'number') {
                    perbaruiStok(idMenu, hasil.stok);
                }

                const keranjang = document.getElementById('keranjangPesanan');

                let item = keranjang.querySelector(
                    `[data-cart-item][data-id-menu="${idMenu}"]`
                );

                if (hasil.removed) {
                    if (item) {
                        item.remove();
                    }

                    perbaruiTampilanKosong();
                }
                else if (isTambahMenu) {
                    if (item) {
                        perbaruiJumlahItem(item, hasil.jumlah);

                        item.querySelector('[data-subtotal]').textContent =
                            'Rp ' + formatRupiah(hasil.subtotal);
                    } else {
                        const token = form.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                        const idMeja = form.querySelector(
                            'input[name="idMeja"]'
                        ).value;

                        const data = {
                            idMenu: hasil.idMenu,
                            namaMenu: hasil.namaMenu,
                            jumlah: hasil.jumlah,
                            harga: Number(form.dataset.hargaMenu),
                            subtotal: hasil.subtotal
                        };

                        const itemBaru = buatItemKeranjang(
                            data,
                            token,
                            idMeja
                        );

                        const placeholder = document.getElementById(
                            'keranjangKosong'
                        );

                        if (placeholder) {
                            placeholder.remove();
                        }

                        keranjang.appendChild(itemBaru);
                    }

                    document.getElementById(
                        'tombolSimpanPesanan'
                    ).disabled = false;
                }
                else if (item) {
                    perbaruiJumlahItem(item, hasil.jumlah);

                    item.querySelector('[data-subtotal]').textContent =
                        'Rp ' + formatRupiah(hasil.subtotal);
                }

                perbaruiTotal(hasil.total);

                tampilkanPesan(hasil.message, 'success');

            } catch (error) {
                tampilkanPesan(
                    'Terjadi kesalahan saat menghubungi server. Silakan coba lagi.',
                    'danger'
                );
            } finally {
                if (isTambahMenu) {
                    const labelStok = document.querySelector(
                        `[data-stok-menu="${form.querySelector('input[name="idMenu"]').value}"]`
                    );

                    const stok = labelStok
                        ? Number(labelStok.textContent.replace('Stok:', '').trim())
                        : 0;

                    tombol.disabled = stok <= 0;
                } else {
                    tombol.disabled = false;
                }
            }
        });
    </script>
}
